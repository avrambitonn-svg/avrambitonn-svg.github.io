# העתיקו לקובץ .env (לא נשמר בגיט). ב-Vercel מגדירים את אותם משתנים ב-Project Settings → Environment Variables.

# ---- כללי ----
# פורט לשרת המקומי (ברירת מחדל 8787)
PORT=8787
# דומיינים של האפליקציה שמורשים לקרוא לשרת, מופרדים בפסיקים ("*" רק לפיתוח מקומי)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# סוד משותף לנתיבי האינטגרציות (Priority, AI, וואטסאפ, Google) בשרת בלי מסד נתונים משותף (DB_MODE=off, למשל Vercel).
# כשיש מסד עם משתמשים, הנתיבים האלה דורשים התחברות, וה-APP_TOKEN לבדו לא מספיק.
# בלי APP_TOKEN ובלי משתמשים הנתיבים פתוחים רק מהמחשב של השרת עצמו (פיתוח מקומי)
APP_TOKEN=

# ---- פריוריטי (ERP) ----
# off = כבוי, demo = סביבת הדמו הציבורית של פריוריטי (קריאה בלבד), live = המערכת של Genair
PRIORITY_MODE=demo
# כתובת ה-OData של החברה ב-live, למשל https://xxx.priority-connect.online/odata/Priority/tabula.ini/genair
PRIORITY_URL=
# משתמש API שהוקם בפריוריטי (משתמשים בו או ב-PAT)
PRIORITY_USER=
# סיסמת משתמש ה-API
PRIORITY_PASSWORD=
# Personal Access Token מפריוריטי (במקום משתמש וסיסמה; נשלח כשם משתמש עם הסיסמה PAT)
PRIORITY_PAT=
# מזהה אפליקציה מפריוריטי, אם השותף/פריוריטי הנפיקו (נשלח ככותרת X-App-Id)
PRIORITY_APP_ID=
# מפתח אפליקציה מפריוריטי, אם הונפק (נשלח ככותרת X-App-Key)
PRIORITY_APP_KEY=
# true מאפשר יצירת לקוחות, הצעות מחיר והזמנות. ברירת מחדל false. פועל רק עם PRIORITY_MODE=live: לסביבת הדמו המשותפת לא כותבים אף פעם
PRIORITY_ALLOW_WRITE=false

# ---- AI (Anthropic) ----
# מפתח API מ-console.anthropic.com (נשאר רק בשרת)
ANTHROPIC_API_KEY=
# מודלים מורשים, מופרדים בפסיקים ("*" = כל מודל)
AI_ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# ערכי anthropic-beta שמותר להעביר מהדפדפן, מופרדים בפסיקים
AI_ALLOWED_BETAS=server-side-fallback-2026-07-01
# זמן המתנה מקסימלי לתשובת AI במילישניות (ברירת מחדל 300000 = 5 דקות)
AI_TIMEOUT_MS=300000
# תקרת max_tokens לבקשה אחת (ברירת מחדל 16000). בנוסף: עד 60 בקשות AI בשעה לכל משתמש
AI_MAX_TOKENS=16000

# ---- וואטסאפ (Meta WhatsApp Business Cloud API) ----
# טוקן קבוע של System User מ-Meta Business (הרשאות whatsapp_business_messaging)
WHATSAPP_TOKEN=
# מזהה מספר הטלפון העסקי (Phone number ID) מתוך WhatsApp Manager / App Dashboard
WHATSAPP_PHONE_NUMBER_ID=
# גרסת Graph API (ברירת מחדל v26.0)
WHATSAPP_GRAPH_VERSION=v26.0
# מחרוזת אקראית שבוחרים בעצמכם ומזינים גם בהגדרות ה-Webhook ב-Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret של אפליקציית Meta - לאימות חתימת ה-Webhook. חובה: בלעדיו ה-Webhook דוחה כל הודעה נכנסת
WHATSAPP_APP_SECRET=

# ---- Google (חשבון שירות) ----
# קובץ ה-JSON של חשבון השירות: התוכן עצמו או base64 שלו
GOOGLE_SERVICE_ACCOUNT_JSON=
# מזהה היומן (Settings → Integrate calendar → Calendar ID) שמשותף עם חשבון השירות
GOOGLE_CALENDAR_ID=
# מזהה תיקיית האב ב-Drive (או Shared Drive) שמשותפת עם חשבון השירות
GOOGLE_DRIVE_PARENT_ID=
# אופציונלי: משתמש Workspace להתחזות אליו (רק עם Domain-wide delegation)
GOOGLE_SUBJECT=
# אופציונלי: scope ל-Drive. ברירת מחדל drive.file; אם יש שגיאת appNotAuthorizedToFile אפשר https://www.googleapis.com/auth/drive
GOOGLE_DRIVE_SCOPE=

# ---- מסד נתונים משותף, התחברות וקבצים ----
# file = קובץ JSON בתיקיית DATA_DIR (ברירת מחדל), memory = בזיכרון בלבד (בדיקות), off = שרת אינטגרציות בלבד (ברירת המחדל ב-Vercel)
DB_MODE=file
# תיקיית הנתונים: db.json, הקבצים שהועלו (files/) וגיבוי יומי (backups/). חייבת להיות על דיסק קבוע
DATA_DIR=./data
# סוד לחתימת טוקני ההתחברות (מחרוזת אקראית ארוכה, למשל: openssl rand -base64 48). בלעדיו נוצר סוד ונשמר ב-db.json
AUTH_SECRET=
# הצפנת db.json והגיבויים (AES-256-GCM): מחרוזת אקראית ארוכה (openssl rand -base64 48). לשמור אותה גם מחוץ לשרת:
# בלעדיה אי אפשר לקרוא את הנתונים. קובץ קיים לא מוצפן נקרא כרגיל ונכתב מוצפן מהשמירה הבאה
DB_ENCRYPTION_KEY=
# כמה שעות טוקן תקף בלי שימוש (מתחדש לבד בכל שימוש). ברירת מחדל 12
AUTH_TTL_HOURS=12
# אחרי כמה ימים מהכניסה צריך להקליד סיסמה שוב, גם כשעובדים כל יום (ברירת מחדל 30)
AUTH_MAX_DAYS=30
# קוד שצריך להקליד בהקמה הראשונה (העלאת הנתונים והגדרת סיסמת המנהל). בלעדיו אפשר להקים רק מהמחשב של השרת עצמו
BOOTSTRAP_TOKEN=
# גודל מקסימלי לקובץ שמעלים, במגה-בייט (ברירת מחדל 25)
FILES_MAX_MB=25
# כמה מקום כל הקבצים יחד יכולים לתפוס, במגה-בייט (ברירת מחדל 5000)
FILES_QUOTA_MB=5000
# true כשהשרת מאחורי פרוקסי אחד (Render, Railway, Fly, nginx), או מספר הפרוקסים שלפניו (למשל 2 עם CDN).
# מגבלות הקצב לפי X-Forwarded-For, ורק הכתובות שהפרוקסים עצמם הוסיפו נחשבות
TRUST_PROXY=false
# אחרי כמה ימים מסגירת תיק הקישור לאזור האישי מפסיק לעבוד (ברירת מחדל 365)
PORTAL_TTL_DAYS=365
# כמה זמן (מ"ש) לחכות לפני כתיבת השינויים לדיסק (ברירת מחדל 300; לכל היותר 2 שניות ברצף שינויים)
DB_FLUSH_MS=300

# ---- פלטפורמה ----
# ב-Vercel: 0 מבטל את עוזרי ה-Node של Vercel כדי לקבל את גוף הבקשה המקורי (נדרש לאימות חתימת וואטסאפ)
NODEJS_HELPERS=0
